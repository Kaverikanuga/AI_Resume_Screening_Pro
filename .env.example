# ============================================================
# AI Resume Screening Pro - Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file (it is gitignored).
# ============================================================

# ── Core ────────────────────────────────────────────────────
# Required in production. Generate privately with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Leave blank for development, which generates a temporary key at startup.
SECRET_KEY=

# SQLite by default; use postgresql://user:pass@host/dbname in production
DATABASE_URL=sqlite:///resume_screening.db

# development | production  (production enables Secure cookies, disables debug)
FLASK_ENV=development

# Comma-separated addresses permitted for trusted CLI admin bootstrapping only.
ADMIN_EMAILS=kanugukaveri.31@gmail.com

# Private random secret of at least 32 characters for trusted administrator CLI commands.
# After provisioning your Super Admin, remove this token from the deployment environment.
ADMIN_BOOTSTRAP_TOKEN=

# ── Razorpay Payments (https://dashboard.razorpay.com) ──────
# Test-mode keys first; swap for live keys at launch.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Webhook secret from Dashboard → Settings → Webhooks.
# Subscribe to: payment.captured, payment.authorized, payment.failed
RAZORPAY_WEBHOOK_SECRET=

# ── Email / SMTP (password-reset emails) ────────────────────
# When MAIL_USERNAME and MAIL_PASSWORD are BOTH set, reset links are emailed.
# When empty, the app falls back to flashing the reset link (development mode).
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@airesumescreen.com