# ============================================================
# AI Resume Screening Pro - Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file (it is gitignored).
# ============================================================

# ── Core ────────────────────────────────────────────────────
# REQUIRED. Generate a strong secret, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# SQLite by default; use postgresql://user:pass@host/dbname in production
DATABASE_URL=sqlite:///resume_screening.db

# development | production  (production enables Secure cookies, disables debug)
FLASK_ENV=development

# ── Razorpay Payments (https://dashboard.razorpay.com) ──────
# Test-mode keys first; swap for live keys at launch.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Webhook secret from Dashboard → Settings → Webhooks.
# Subscribe to: payment.captured, payment.authorized, payment.failed
RAZORPAY_WEBHOOK_SECRET=

# ── Email / SMTP (password-reset emails) ────────────────────
# When MAIL_USERNAME and MAIL_PASSWORD are BOTH set, reset links are emailed.
# When empty, the app falls back to flashing the reset link (development mode).
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@airesumescreen.com